# Anvex — single environment file for every stack.
# Copy to `.env` at the repo root. docker-compose injects this into api, worker, beat and web.
# Every new variable MUST be added here in the same commit that introduces it.

# ----- General -----
ANVEX_ENV=local
LOG_LEVEL=INFO

# ----- Postgres -----
POSTGRES_USER=anvex
POSTGRES_PASSWORD=anvex
POSTGRES_DB=anvex
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SCHEMA=anvex

# ----- Redis (Celery broker + result backend) -----
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ----- S3 (MinIO locally, real S3 in AWS) -----
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=anvexminio
S3_SECRET_ACCESS_KEY=anvexminio
S3_BUCKET=anvex-local

# ----- Auth / JWT -----
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ----- Third-party clients -----
ALPHAVANTAGE_API_KEY=
NEWSAPI_API_KEY=

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- Compose host port publications (host side of the port mappings) -----
# Change these if something else already owns the port; nothing inside the compose
# network uses them - containers always talk to each other on the service name.
#
# POSTGRES_HOST_PORT is deliberately NOT 5432: a locally-installed Postgres very often
# owns that port, and on Windows the native server and Docker's proxy can *both* bind it
# successfully - the host then silently reaches the wrong database instead of erroring.
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5442
POSTGRES_TEST_HOST_PORT=5433
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
WEB_HOST_PORT=5173

# ----- Test database (compose service `db-test`) -----
# A throwaway Postgres on its own port with no named volume: it starts empty every time.
# From the host, pytest reaches it at localhost:POSTGRES_TEST_HOST_PORT; from inside the
# compose network it is `db-test:5432`.
#
# These three are read by the pytest harness only (`backend/tests/database.py`), never by
# `app/` - nothing in the application knows `db-test` exists.
POSTGRES_TEST_DB=anvex_test
# Host the test suite dials. `localhost` because pytest normally runs on the host; set it
# to `db-test` to run the suite from inside the compose network.
POSTGRES_TEST_HOST=localhost
# Port the test suite dials. Left unset it falls back to POSTGRES_TEST_HOST_PORT above, so
# there is one number to change. Set it only when the two differ - i.e. in-network, where
# the container listens on 5432:
# POSTGRES_TEST_PORT=5432

# ----- Compose integration tests -----
# `backend/tests/integration/test_compose_health.py` is skipped unless this is exactly
# `1`, so the default suite runs with no Docker at all. Set it only when the stack is up.
ANVEX_COMPOSE_TEST=0
ANVEX_COMPOSE_API_URL=http://localhost:8000

# ----- Frontend (Vite only exposes VITE_* prefixed vars to the browser) -----
VITE_API_BASE_URL=http://localhost:8000
