# Anvex — single environment file for every stack.
# Copy to `.env` at the repo root. docker-compose injects this into api, worker, beat and web.
# Every new variable MUST be added here in the same commit that introduces it.

# ----- General -----
ANVEX_ENV=local
LOG_LEVEL=INFO

# ----- Postgres -----
POSTGRES_USER=anvex
POSTGRES_PASSWORD=anvex
POSTGRES_DB=anvex
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SCHEMA=anvex

# ----- Redis (Celery broker + result backend) -----
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ----- S3 (MinIO locally, real S3 in AWS) -----
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=anvexminio
S3_SECRET_ACCESS_KEY=anvexminio
S3_BUCKET=anvex-local

# ----- Auth / JWT -----
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ----- Third-party clients -----
ALPHAVANTAGE_API_KEY=
NEWSAPI_API_KEY=

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- Frontend (Vite only exposes VITE_* prefixed vars to the browser) -----
VITE_API_BASE_URL=http://localhost:8000
